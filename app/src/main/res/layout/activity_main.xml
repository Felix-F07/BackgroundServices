<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"

    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/txtLacak"
        android:textSize="18sp"
        android:text="Tekan Tombol untuk memulai pelacakan. \nService akan berhenti saat Anda Melompat"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Mulai Lacak Aktivitas"
        android:id="@+id/btnLacak"/>

    <TextView
        android:id="@+id/txtLatihan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tekan tombol untuk memulai latihan."
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnLatihan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Mulai Latihan" />

    <Button
        android:id="@+id/btnTambahKalender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tambahkan ke Kalender"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>